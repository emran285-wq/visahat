# Copy this file to .env locally or create it outside the public document root in production.
# Use the public HTTPS origin in production; do not include a trailing slash.
SITE_URL=http://127.0.0.1:8080

# The current site intentionally supports demo (client-side preview) and disabled modes only.
# A live handler must be implemented and reviewed before using any other value.
FORM_MODE=demo

# Reserved for a reviewed future integration. Leave blank when unused.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
MAIL_FROM=
MAIL_TO=
